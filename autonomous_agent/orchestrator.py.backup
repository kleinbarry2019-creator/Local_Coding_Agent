class AgentOrchestrator:

    def __init__(
        self,
        planner=None,
        loop=None,
        engine=None,
        state=None,
        memory=None,
    ):
        self.planner = planner
        self.loop = loop
        self.engine = engine
        self.state_manager = state
        self.state = getattr(state, "state", state or {})
        self.memory = memory


    def run(self, goal):

        self.state["goal"] = goal
        self.state["status"] = "running"

        if self.state_manager:
            self.state_manager.save_snapshot("before-run")
            self.state_manager.save()

        if self.planner:
            plan = self.planner.create_plan(goal)
            self.state["plan"] = plan

            if self.engine:
                for step in plan:
                    if self.state_manager:
                        self.state_manager.save_snapshot(
                            f"before-step-{step.action}"
                        )

                    result = self.engine.execute(step)
                    self.state["last_result"] = result

                    if self.state_manager:
                        self.state_manager.save_snapshot(
                            f"after-step-{step.action}"
                        )
                        self.state_manager.save()

        if self.memory:
            self.memory.store(
                "last_goal",
                goal
            )

        self.state["status"] = "completed"

        if self.state_manager:
            self.state_manager.save_snapshot("run-completed")
            self.state_manager.save()

        return self.state


    def execute(self, goal):
        return self.run(goal)


Orchestrator = AgentOrchestrator
